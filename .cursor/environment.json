{
  "name": "AI Studio Prototype",
  "install": ".cursor/install.sh",
  "terminals": [
    {
      "name": "backend",
      "description": "FastAPI API server (port 8000)",
      "command": "cd backend && .venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --reload"
    },
    {
      "name": "frontend",
      "description": "Static frontend dev server (port 5500)",
      "command": "cd frontend && python3 -m http.server 5500 --bind 0.0.0.0"
    }
  ],
  "ports": [
    {
      "name": "api",
      "port": 8000
    },
    {
      "name": "frontend",
      "port": 5500
    }
  ]
}
