JWT_SECRET=dev-only-change-me-please-use-a-long-random-secret-key
DB_NAME=aistudio
DB_USER=aistudio
DB_PASSWORD=aistudio
# Dev (docker compose default / Vite). For staging GHCR deploy use HTTPS — see below.
CORS_ORIGINS=http://localhost:5173,http://localhost:8088
AI_PROVIDER=mock
# AI_PROVIDER=openai|anthropic|mock|routing
# AI_PROVIDER=routing
# AI_PROVIDER_CHAIN=openai,anthropic,mock
# AI_PROVIDER_FALLBACKS=anthropic,mock
# AI_CIRCUIT_BREAKER_ENABLED=true
# AI_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
# AI_CIRCUIT_BREAKER_OPEN_SECONDS=60
# AI_ADAPTIVE_ROUTING_ENABLED=false
# AI_ADAPTIVE_ROUTING_SAMPLE_SIZE=50
# Adaptive routing: docs/40-ADAPTIVE-AI-ROUTING-GUIDE.md
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
AI_RATE_LIMIT_PER_MINUTE=30
EMBEDDING_PROVIDER=mock
RAG_ENABLED=true
BILLING_APP_BASE_URL=http://localhost:5173
# BILLING_PROVIDER=mock|stripe
# STRIPE_API_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRO_PRICE_ID=
# STRIPE_TEAM_PRICE_ID=
# STRIPE_PRO_SEAT_METERED_PRICE_ID=
# STRIPE_TEAM_SEAT_METERED_PRICE_ID=
# STRIPE_PRO_AI_OVERAGE_METERED_PRICE_ID=
# STRIPE_TEAM_AI_OVERAGE_METERED_PRICE_ID=
# BILLING_USAGE_SYNC_TOKEN=
# SSO_PROVIDER=mock|oidc|saml
# MAIL_PROVIDER=logging|smtp
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USER=
# MAIL_PASSWORD=
# MAIL_FROM=noreply@example.com
# OIDC_ISSUER_URI=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_DISPLAY_NAME=Continue with SSO
SSO_ENABLED=true
SSO_PROVIDER=mock
SSO_APP_BASE_URL=http://localhost:5173
# Optional: static bearer for internal Prometheus scrapes (never expose on public edge)
# METRICS_SCRAPE_TOKEN=
# LOKI_RETENTION_PERIOD=720h
# LOKI_OBJECT_STORE=filesystem|s3
# LOKI_S3_BUCKET=
# LOKI_S3_REGION=
# LOKI_S3_ACCESS_KEY_ID=
# LOKI_S3_SECRET_ACCESS_KEY=
# LOKI_S3_ENDPOINT=
# LOKI_EXPORT_HOURS=24
# LOKI_ARCHIVE_S3_URI=s3://bucket/prefix
# LOKI_QUERY_REGIONS=us-east=http://loki-us:3100,eu-west=http://loki-eu:3100
# PROMETHEUS_QUERY_REGIONS=us-east=http://prom-us:9090,eu-west=http://prom-eu:9090
# PROMETHEUS_CLUSTER_NAME=local
# ALERTMANAGER_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# ALERTMANAGER_PAGERDUTY_ROUTING_KEY=
# ALERTMANAGER_WEBHOOK_URL=
# ALERTMANAGER_QUERY_REGIONS=us-east=http://am-us:9093,eu-west=http://am-eu:9093
# Alertmanager on-call: docs/39-ALERTMANAGER-ONCALL-GUIDE.md
# LOKI_QUERY='{service="api"} | json | level="ERROR"'
# LOKI_QUERY_HOURS=6
# Multi-region Loki: docs/27-LOKI-MULTI-REGION-QUERY-GUIDE.md
# Log archive: docs/17-LOG-ARCHIVE-GUIDE.md
# CHAT_ARCHIVE_ACCESS_TOKEN=
# CHAT_ARCHIVE_ORG_ID=
# CHAT_ARCHIVE_S3_URI=s3://bucket/chat-archives
# CHAT_EXPORT_REDACTION_POLICY=standard
# CHAT_EXPORT_COMPLIANCE_REDACTION_POLICY=none
# Chat archive sync: docs/19-CHAT-ARCHIVE-SYNC-GUIDE.md
# ARCHIVE_S3_BUCKET=
# ARCHIVE_GLACIER_DAYS=90
# ARCHIVE_DEEP_ARCHIVE_DAYS=365
# DEST_S3_BUCKET=
# DEST_S3_REGION=
# S3_REPLICATION_ROLE_ARN=
# Long-term archive: docs/21-OBSERVABILITY-LONG-TERM-ARCHIVE-GUIDE.md
# WORKER_REPLICAS=3
# WORKER_REPLICAS_MAX=6
# WORKER_TARGET_PENDING_PER_REPLICA=10
# Worker autoscaling: docs/18-JOB-WORKER-AUTOSCALING-GUIDE.md
# AISTUDIO_JOBS_WORKER_ENABLED=true
# JOB_POLL_INTERVAL_MS=2000
# GRAFANA_ADMIN_PASSWORD=admin
# ./scripts/write-prometheus-token.sh && docker compose -f docker-compose.yml -f docker-compose.monitoring.yml up -d
# Production / staging (prod Spring profile — HTTPS required, no localhost)
# SPRING_PROFILES_ACTIVE=prod
# CORS_ORIGINS=https://staging.example.com
# BILLING_APP_BASE_URL=https://staging.example.com
# SSO_APP_BASE_URL=https://staging.example.com
# OIDC setup: docs/15-OIDC-IDP-GUIDE.md
# SAML stub (dev/CI only): docs/16-SAML-SSO-STUB.md
# SAML_STUB_MODE=true
# SAML_METADATA_URL=
# SAML_ENTITY_ID=
# SAML_ACS_URL=https://api.example.com/api/v1/auth/sso/saml/acs
# SAML_DISPLAY_NAME=Continue with SAML
# SAML_SP_PRIVATE_KEY=   # PEM — enables signed AuthnRequest when paired with cert
# SAML_SP_CERTIFICATE=   # PEM — register at IdP; required for encrypted assertions
# SAML_WANT_ENCRYPTED_ASSERTIONS=false
# SAML signing: docs/26-SAML-SIGNING-GUIDE.md
