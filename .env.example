JWT_SECRET=dev-only-change-me-please-use-a-long-random-secret-key
DB_NAME=aistudio
DB_USER=aistudio
DB_PASSWORD=aistudio
# Dev (docker compose default / Vite). For staging GHCR deploy use HTTPS — see below.
CORS_ORIGINS=http://localhost:5173,http://localhost:8088
AI_PROVIDER=mock
# AI_PROVIDER=openai|anthropic|mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
AI_RATE_LIMIT_PER_MINUTE=30
EMBEDDING_PROVIDER=mock
RAG_ENABLED=true
BILLING_APP_BASE_URL=http://localhost:5173
# BILLING_PROVIDER=mock|stripe
# STRIPE_API_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRO_PRICE_ID=
# STRIPE_TEAM_PRICE_ID=
# SSO_PROVIDER=mock|oidc
# MAIL_PROVIDER=logging|smtp
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USER=
# MAIL_PASSWORD=
# MAIL_FROM=noreply@example.com
# OIDC_ISSUER_URI=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_DISPLAY_NAME=Continue with SSO
SSO_ENABLED=true
SSO_PROVIDER=mock
SSO_APP_BASE_URL=http://localhost:5173
# Optional: static bearer for internal Prometheus scrapes (never expose on public edge)
# METRICS_SCRAPE_TOKEN=
# Dedicated job worker (prod/staging — api sets AISTUDIO_JOBS_WORKER_ENABLED=false via compose overlays)
# AISTUDIO_JOBS_WORKER_ENABLED=true
# JOB_POLL_INTERVAL_MS=2000
# GRAFANA_ADMIN_PASSWORD=admin
# ./scripts/write-prometheus-token.sh && docker compose -f docker-compose.yml -f docker-compose.monitoring.yml up -d
# Production / staging (prod Spring profile — HTTPS required, no localhost)
# SPRING_PROFILES_ACTIVE=prod
# CORS_ORIGINS=https://staging.example.com
# BILLING_APP_BASE_URL=https://staging.example.com
# SSO_APP_BASE_URL=https://staging.example.com
#
# Staging compose (docker-compose.staging.yml) — pull from GHCR
# IMAGE_TAG=main
# IMAGE_TAG=0.1.0-beta   # semver tag from git tag v0.1.0-beta
# IMAGE_TAG=v0.1.0-beta  # git tag ref (also published after publish.yml fix)
# IMAGE_TAG=v0.2.1-beta
# API_IMAGE=ghcr.io/siddisadad/deshmukh-ai-studio/api:main
# FRONTEND_IMAGE=ghcr.io/siddisadad/deshmukh-ai-studio/frontend:main
# STAGING_UI_PORT=8088
# STAGING_API_PORT=8080
# ./scripts/staging-ghcr-deploy.sh
#
# Staging dry-run (local build, no GHCR)
# STAGING_UI_PORT=8091
# STAGING_API_PORT=8092
